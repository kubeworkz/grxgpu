VORTEX_VERSION ?= @VORTEX_VERSION@

# Relocatable source root: trust the configured path when it exists, but if
# the build tree was produced elsewhere (e.g. artifacts built on a hosted
# runner at /home/runner/work/... and consumed on a self-hosted runner),
# fall back to this build dir's parent, which is always <repo>/build<NN>.
VORTEX_HOME ?= @VORTEX_HOME@
ifeq (,$(wildcard $(VORTEX_HOME)/VX_config.toml))
VORTEX_HOME := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
endif

VERILATOR_PATH ?= $(TOOLDIR)/verilator

# Checksum Verilator PCH so ccache invalidates on model-layout changes.
export CCACHE_PCH_EXTSUM := true

XLEN ?= @XLEN@

TOOLDIR ?= @TOOLDIR@

OSVERSION ?= @OSVERSION@

INSTALLDIR ?= @INSTALLDIR@

LLVM_PATH ?= $(TOOLDIR)/llvm-vortex

LIBC_PATH ?= $(TOOLDIR)/libc$(XLEN)
LIBCRT_PATH ?= $(TOOLDIR)/libcrt$(XLEN)

RISCV_TOOLCHAIN_PATH ?= $(TOOLDIR)/riscv$(XLEN)-gnu-toolchain

RISCV_PREFIX  ?= riscv$(XLEN)-unknown-elf
RISCV_SYSROOT ?= $(RISCV_TOOLCHAIN_PATH)/$(RISCV_PREFIX)

THIRD_PARTY_DIR ?= $(VORTEX_HOME)/third_party

SW_COMMON_DIR ?= $(VORTEX_HOME)/sw/common

SIM_COMMON_DIR ?= $(VORTEX_HOME)/sim/common
