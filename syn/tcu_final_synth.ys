# Yosys script: read include files by concatenation
# Pre-concatenate all .vh includes into a single file, then read modules
read_verilog -sv /work/all_includes.vh
read_verilog -sv /rtl/tcu/VX_tcu_pkg.sv

# TFR submodules (16 modules - already working)
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_wmul.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_shared_mul.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_join.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_f16.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_f8.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_f4.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_i8.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_mul_i4.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_classifier.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_align.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_max_exp.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_lane_mask.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_exc_reduce.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_norm_round.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_acc.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_tfr_pipe_register.sv
read_verilog -sv /rtl/tcu/tfr/VX_tcu_fedp_tfr.sv

# TCU core modules
read_verilog -sv /rtl/tcu/VX_tcu_mx_scale.sv
read_verilog -sv /rtl/tcu/VX_tcu_lockstep.sv
read_verilog -sv /rtl/tcu/VX_tcu_dsm.sv
read_verilog -sv /rtl/tcu/VX_tcu_meta.sv
read_verilog -sv /rtl/tcu/VX_tcu_sp_mux.sv
read_verilog -sv /rtl/tcu/VX_tcu_tbuf.sv
read_verilog -sv /rtl/tcu/VX_tcu_abuf.sv
read_verilog -sv /rtl/tcu/VX_tcu_bbuf.sv
read_verilog -sv /rtl/tcu/VX_tcu_agu.sv
read_verilog -sv /rtl/tcu/VX_tcu_wgmma.sv
read_verilog -sv /rtl/tcu/VX_tcu_uops.sv
read_verilog -sv /rtl/tcu/VX_tcu_core.sv
read_verilog -sv /rtl/tcu/VX_tcu_unit.sv

proc
opt_clean
opt
techmap
synth_ecp5 -abc9 -dff -top VX_tcu_unit
stat
