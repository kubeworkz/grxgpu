/build*
/.*
!/.github/
!/.github/**
# Archived/superseded docs — kept on disk, never tracked
docs/archives/

# Source export artifact (never tracked)
grxgpu-src.tar.gz

# Freebuff harness workspace state (never tracked; gitlink here breaks CI submodule checkout)
/.freebuff/

# Build and run byproducts (regenerated by make; never tracked)
*.stamp
.depend
*.stats.log
.DS_Store
# In-tree host binaries, compiled shaders and run output
/tests/opencl/kmeans/kmeans
/tests/opencl/spmv/spmv.host
/tests/opencl/transpose/transpose
/tests/opencl/vecadd/vecadd
/tests/vulkan/draw3d/*.spv
/tests/vulkan/draw3d/draw3d_out.png
/tests/vulkan/draw3d/trace/

# Generic compiler/Verilator output (no legitimate tracked files of these types)
*.o
*.a
*.so
*.elf
*.vxbin
*.pyc
*.dump
*.log.ch[0-9]*
# ramulator trace/stats output written to the working directory
/trace/
